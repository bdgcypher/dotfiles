# App Specific
bitwarden/.config/Bitwarden/
gh/.config/gh/
vesktop/.config/vesktop/sessionData/
vesktop/.config/vesktop/state.json
vesktop/.config/vesktop/themes/pywal-vencord.theme.css
# Local theme state (pywal-generated / machine-specific, created by post-stow hook)
theme/.config/theme/current_wallpaper
theme/.config/theme/default_theme_mode
theme/.config/theme/current_theme_mode
# GTK pywal css — rewritten by apply-wallpaper on every wallpaper change
gtk-4.0/.config/gtk-4.0/gtk.css
gtk-4.0/.config/gtk-4.0/gtk-dark.css
chromium/.config/chromium/
mozilla/.config/mozilla/firefox/
slack/.config/Slack/
.mozilla/

# System
system_snapshot.txt

# uwsm runtime state (written via the ~/.config/uwsm stow symlink)
uwsm/.config/uwsm/default-id

# KDE Connect identity keys — machine-specific, generated on first run
kdeconnect/.config/kdeconnect/certificate.pem
kdeconnect/.config/kdeconnect/privateKey.pem

# Python bytecode caches (scripts run from the stowed repo dir)
__pycache__/
*.pyc

# Compiled Rust helper binaries (built by stow_configs.sh into the stowed bin)
bin/.local/bin/hypr-tiling-direction-watch
bin/.local/bin/rebalance-pywal-colorscheme
rust/target/
