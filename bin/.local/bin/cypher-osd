#!/usr/bin/env bash
# cypher-osd -- the on-screen display, drawn by cypher-shell.
#
# The flags and the split of work are swayosd's: the client does the work (wpctl,
# brightnessctl, playerctl) and the server draws -- except the server here is the
# Quickshell shell, reached over its IPC socket. The option names are
# swayosd-client's because the keybinds in this repo were written against its CLI.
#
#   cypher-osd --output-volume raise
#   cypher-osd --input-volume mute-toggle
#   cypher-osd --brightness +5 --device intel_backlight
#   cypher-osd --custom-message "Screenshot copied" --custom-icon edit-copy
#   cypher-osd --monitor eDP-1 --brightness -10
#
# The work happens whether or not the shell is up; only the overlay needs it. So a
# stopped shell costs the pill, never the volume or brightness change itself.
#
# Differences from swayosd-client, all deliberate:
#   * --brightness raise/lower step 5% of the panel's maximum. swayosd's own
#     handling of raise/lower together with --device is erratic here (some
#     combinations do nothing, --brightness -10 once *raised* it), so the
#     keybindings that use that form were silently doing nothing.
#   * The floor is 5% of maximum, which is what swayosd's min-brightness default
#     turns out to be (measured: --brightness -100 lands on 20/400).
#   * --custom-segmented-progress is drawn as a continuous bar with the same
#     fraction; nothing in the dotfiles uses segments.

set -uo pipefail

SHELL_ID="cypher-shell"
IPC_TARGET="osd"

# swayosd's defaults, from its config.toml and its measured behaviour.
MAX_VOLUME="100"       # swayosd's max_volume = 100
MIN_BRIGHTNESS="5"     # per-cent floor
STEP_VOLUME="5"        # per-cent step for raise/lower
STEP_BRIGHTNESS="5"

# ── the shell ────────────────────────────────────────────────────────────────

# Whether the shell's OSD answers. This runs on every volume key press, so it
# is file inspection rather than a round trip: `qs ipc` spends ~60ms resolving
# the instance and speaking the protocol, and the socket file only exists while
# the shell is up, which is the whole question. The instance id is random, so
# match the config path inside each instance's lock (UTF-16LE, hence the
# dotted pattern) and require that instance's socket to be there.
shell_up() {
	local lock
	for lock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/quickshell/by-id/*/instance.lock; do
		[ -e "$lock" ] || return 1
		if grep -qa 'c.y.p.h.e.r.-.s.h.e.l.l' "$lock" 2>/dev/null && [ -S "${lock%/*}/ipc.sock" ]; then
			return 0
		fi
	done
	return 1
}

# ── spec ─────────────────────────────────────────────────────────────────────

# Sends one OSD to the shell. Empty strings mean "not part of this OSD", which is
# how the shell tells a value bar from a custom message: it draws only what it is
# given, so --custom-message with no progress has no bar, like swayosd's.
#
# JSON built in bash rather than python3: an interpreter start costs ~50ms and
# this runs on every volume key press. Only ever three shapes of value go in --
# fixed identifiers, numbers from wpctl/brightnessctl, and free text -- so the
# escaper needs nothing beyond backslash, quote and line characters.
json_escape() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/ }
	s=${s//$'\r'/ }
	s=${s//$'\t'/ }
	printf '%s' "$s"
}

send_spec() {
	local kind="$1" icon="$2" label="$3" progress="$4" value="$5" muted="$6"
	local json="{\"kind\":\"$(json_escape "$kind")\""

	[ -n "$icon" ] && json+=",\"icon\":\"$(json_escape "$icon")\""
	[ -n "$label" ] && json+=",\"label\":\"$(json_escape "$label")\""
	# Numbers pass through only when they look like numbers: upstream is
	# awk/printf output, but an empty or odd string must not become JSON the
	# shell has to reject.
	case "$progress" in ''|*[!0-9.-]*) ;; *) json+=",\"progress\":$progress" ;; esac
	case "$value" in ''|*[!0-9.-]*) ;; *) json+=",\"value\":$value" ;; esac
	[ -n "$muted" ] && json+=",\"muted\":$([ "$muted" = 1 ] && echo true || echo false)"
	[ -n "${MONITOR:-}" ] && json+=",\"monitor\":\"$(json_escape "$MONITOR")\""
	[ -n "${DURATION:-}" ] && json+=",\"duration\":$DURATION"
	json+="}"

	# Nothing to draw on: skip the round trip (~60ms) rather than spend it on a
	# socket nobody is listening to. The OSD is cosmetic, so neither is an error.
	shell_up || return 0

	# The handler is named `flash` because `qs ipc` owns `show` as a subcommand.
	qs ipc -c "$SHELL_ID" call "$IPC_TARGET" flash "$json" >/dev/null 2>&1
}

# ── audio ────────────────────────────────────────────────────────────────────

# wpctl prints "Volume: 0.40" or "Volume: 0.40 [MUTED]". One call yields both
# the level and the mute state, so reading them together halves the cost --
# each wpctl start is ~35ms and the audio path runs on every volume press.
audio_state() {
	local line value
	line=$(wpctl get-volume "$1" 2>/dev/null) || return 1
	value=${line#*: }
	value=${value%%[[:space:]]*}
	printf '%s %s\n' "$value" "$([ "${line#*[}" != "$line" ] && echo 1 || echo 0)"
}

# swayosd caps raising at max_volume but never drags a volume that is already
# above it back down -- volume-boost deliberately runs the sink at 125%.
volume_limit() {
	local current="$1" limit

	# awk, not python3 or bc: this runs on every raise, and both of those are
	# interpreter starts (~50ms and not installed respectively).
	limit=$(awk -v m="$MAX_VOLUME" 'BEGIN { printf "%.4f", m / 100 }' 2>/dev/null) || limit="1"
	if awk -v c="$current" -v l="$limit" 'BEGIN { exit !(c > l) }'; then
		echo "$current"
	else
		echo "$limit"
	fi
}

audio_osd() {
	local kind="$1" target="$2" mode="$3"
	local before state value muted limit

	# The state before the change. The raise limit needs the level, and every
	# mode uses the whole thing as the comparison for the read-poll below:
	# wireplumber applies set-volume and set-mute asynchronously, so a single
	# read right after the change can still be the old state -- the mute icon
	# visibly lagged one key press behind without this.
	before=$(audio_state "$target") || return 0
	value=${before% *}
	[ -n "$value" ] || return 0

	case "$mode" in
	raise)
		limit=$(volume_limit "$value")
		wpctl set-volume -l "$limit" "$target" "${STEP_VOLUME}%+" 2>/dev/null ;;
	lower)
		wpctl set-volume "$target" "${STEP_VOLUME}%-" 2>/dev/null ;;
	mute)
		wpctl set-mute "$target" 1 2>/dev/null ;;
	unmute)
		wpctl set-mute "$target" 0 2>/dev/null ;;
	mute-toggle)
		wpctl set-mute "$target" toggle 2>/dev/null ;;
	+0)
		# Nothing changed, so the pre-change state is the answer; no read-poll.
		send_spec "$kind" "" "" "$value" "$value" "${before#* }"
		return 0 ;;
	+*)
		limit=$(volume_limit "$value")
		wpctl set-volume -l "$limit" "$target" "${mode#+}%+" 2>/dev/null ;;
	-*)
		wpctl set-volume "$target" "${mode#-}%-" 2>/dev/null ;;
	*)
		return 0 ;;
	esac

	# Wait for wireplumber to settle: poll until the state differs from the
	# pre-change one, or the deadline passes. A change that is a genuine no-op
	# -- the 0% floor, the max-volume cap -- never differs, and then the last
	# read is the right answer anyway. The common case exits on the first
	# poll, one extra wpctl (~35ms) for an OSD that tells the truth.
	state=$before
	while (( SECONDS < 1 )); do
		state=$(audio_state "$target") || state=$before
		[ "$state" != "$before" ] && break
		sleep 0.02
	done

	value=${state% *}
	muted=${state#* }
	[ -n "$value" ] || value=${before% *}

	send_spec "$kind" "" "" "$value" "$value" "$muted"
}

# ── brightness ───────────────────────────────────────────────────────────────

# --device names a backlight (intel_backlight); without one, the whole backlight
# class is addressed and brightnessctl applies the change to every panel.
brightness_args() {
	if [ -n "${DEVICE:-}" ]; then
		printf '%s\n' -d "$DEVICE"
	else
		printf '%s\n' -c backlight
	fi
}

brightness_osd() {
	local mode="$1"
	local -a dev
	local max current pct floor

	mapfile -t dev < <(brightness_args)
	max=$(brightnessctl "${dev[@]}" max 2>/dev/null) || return 0
	[ -n "$max" ] && [ "$max" -gt 0 ] 2>/dev/null || return 0

	case "$mode" in
	raise) brightnessctl "${dev[@]}" set "${STEP_BRIGHTNESS}%+" >/dev/null 2>&1 ;;
	lower) brightnessctl "${dev[@]}" set "${STEP_BRIGHTNESS}%-" >/dev/null 2>&1 ;;
	+0) ;;
	+*) brightnessctl "${dev[@]}" set "${mode#+}%+" >/dev/null 2>&1 ;;
	-*) brightnessctl "${dev[@]}" set "${mode#-}%-" >/dev/null 2>&1 ;;
	*) return 0 ;;
	esac

	# Floor: swayosd will not go below 5% of maximum, so a held-down brightness
	# key cannot leave a black screen behind.
	floor=$((max * MIN_BRIGHTNESS / 100))
	current=$(brightnessctl "${dev[@]}" get 2>/dev/null) || return 0
	if [ "$current" -lt "$floor" ]; then
		brightnessctl "${dev[@]}" set "$floor" >/dev/null 2>&1
		current=$floor
	fi

	pct=$(awk -v c="$current" -v m="$max" 'BEGIN { printf "%.4f", c / m }' 2>/dev/null) || return 0
	send_spec "brightness" "" "" "$pct" "$pct" ""
}

# ── media ────────────────────────────────────────────────────────────────────

# playerctl, with --player passed through when the caller named one.
playerctl_() {
	if [ -n "${PLAYER:-}" ] && [ "$PLAYER" != "auto" ]; then
		playerctl --player "$PLAYER" "$@" 2>/dev/null
	else
		playerctl "$@" 2>/dev/null
	fi
}

playerctl_osd() {
	# Initialised, not just declared: `set -u` treats a bare `local name` as still
	# unset, and the label is only written when the track has an artist or a
	# title. Declaring them bare made every play/pause, next, prev, stop and
	# shuffle OSD die on "label: unbound variable" before it sent anything.
	local action="$1" status="" icon="" label="" artist="" title=""

	playerctl_ "$action" >/dev/null 2>&1 || return 0

	case "$action" in
	play-pause | play | pause)
		status=$(playerctl_ status)
		[ "$status" = "Playing" ] && icon="media-playback-pause-symbolic" || icon="media-playback-start-symbolic"
		;;
	next) icon="media-skip-forward-symbolic" ;;
	prev) icon="media-skip-backward-symbolic" ;;
	stop) icon="media-playback-stop-symbolic" ;;
	shuffle) icon="media-playlist-shuffle-symbolic" ;;
	*) icon="media-playback-start-symbolic" ;;
	esac

	# swayosd shows "{artist} - {title}" for the track actions, and only for the
	# ones that move the track: play/pause is a bare icon, as it is there.
	if [ "$action" != "play-pause" ] && [ "$action" != "play" ] && [ "$action" != "pause" ]; then
		artist=$(playerctl_ metadata artist)
		title=$(playerctl_ metadata title)
		if [ -n "$artist" ] && [ -n "$title" ]; then
			label="$artist - $title"
		elif [ -n "$title" ]; then
			label="$title"
		fi
	fi

	send_spec "playerctl" "$icon" "$label" "" "" ""
}

# ── locks ────────────────────────────────────────────────────────────────────

# Reads the LED class for a lock key. swayosd's --*-led flags name the LED
# directory; without one the usual <name>_lock match is used.
lock_led() {
	local key="$1" override="${2:-}" dir state

	if [ -n "$override" ]; then
		dir="$override"
		[ -d "$dir" ] || return 0
	else
		dir=$(find /sys/class/leds -maxdepth 1 -iname "*${key}*" 2>/dev/null | head -1)
	fi
	[ -n "$dir" ] && [ -r "$dir/brightness" ] || return 0

	state=$(cat "$dir/brightness" 2>/dev/null) || return 0
	printf '%s\n' "$([ "$state" != "0" ] && echo 1 || echo 0)"
}

lock_osd() {
	local key="$1" led="$2" state

	state=$(lock_led "$key" "$led")
	[ -n "$state" ] || return 0

	case "$key" in
	caps) send_spec "caps-lock" "" "$([ "$state" = "1" ] && echo On || echo Off)" "" "$state" "" ;;
	num) send_spec "num-lock" "" "$([ "$state" = "1" ] && echo On || echo Off)" "" "$state" "" ;;
	scroll) send_spec "scroll-lock" "" "$([ "$state" = "1" ] && echo On || echo Off)" "" "$state" "" ;;
	esac
}

# ── arguments ────────────────────────────────────────────────────────────────

OUTPUT_VOLUME="" INPUT_VOLUME="" BRIGHTNESS=""
DEVICE="" MAX_VOLUME_OPT="" MIN_BRIGHTNESS_OPT=""
PLAYERCTL="" PLAYER="" MONITOR="" DURATION=""
CUSTOM_MESSAGE="" CUSTOM_ICON="" CUSTOM_PROGRESS="" CUSTOM_PROGRESS_TEXT=""
CAPS_LOCK=0 NUM_LOCK=0 SCROLL_LOCK=0
CAPS_LED="" NUM_LED="" SCROLL_LED=""
EXTRA=()

while [ $# -gt 0 ]; do
	case "$1" in
	--output-volume) OUTPUT_VOLUME="${2:-}"; shift 2 ;;
	--input-volume) INPUT_VOLUME="${2:-}"; shift 2 ;;
	--brightness) BRIGHTNESS="${2:-}"; shift 2 ;;
	--device) DEVICE="${2:-}"; shift 2 ;;
	--max-volume) MAX_VOLUME_OPT="${2:-}"; shift 2 ;;
	--min-brightness) MIN_BRIGHTNESS_OPT="${2:-}"; shift 2 ;;
	--playerctl) PLAYERCTL="${2:-}"; shift 2 ;;
	--player) PLAYER="${2:-}"; shift 2 ;;
	--custom-message) CUSTOM_MESSAGE="${2:-}"; shift 2 ;;
	--custom-icon) CUSTOM_ICON="${2:-}"; shift 2 ;;
	--custom-progress) CUSTOM_PROGRESS="${2:-}"; shift 2 ;;
	--custom-progress-text) CUSTOM_PROGRESS_TEXT="${2:-}"; shift 2 ;;
	--custom-segmented-progress)
		# value:segments -- drawn as the same fraction of a continuous bar.
		_seg="${2:-}"
		CUSTOM_PROGRESS=$(awk -F: -v s="$_seg" 'BEGIN {
			n = split(s, p, ":")
			if (n == 2 && p[1] ~ /^[0-9]+$/ && p[2] ~ /^[0-9]+$/ && p[2] + 0 > 0)
				printf "%.4f", p[1] / p[2]
		}' 2>/dev/null)
		shift 2
		;;
	--caps-lock) CAPS_LOCK=1; shift ;;
	--num-lock) NUM_LOCK=1; shift ;;
	--scroll-lock) SCROLL_LOCK=1; shift ;;
	--caps-lock-led) CAPS_LED="${2:-}"; CAPS_LOCK=1; shift 2 ;;
	--num-lock-led) NUM_LED="${2:-}"; NUM_LOCK=1; shift 2 ;;
	--scroll-lock-led) SCROLL_LED="${2:-}"; SCROLL_LOCK=1; shift 2 ;;
	--monitor) MONITOR="${2:-}"; shift 2 ;;
	-d | --duration) DURATION="${2:-}"; shift 2 ;;
	-h | --help)
		cat >&2 <<'EOF'
usage: cypher-osd <what to show> [options]

  --output-volume <raise|lower|mute-toggle|mute|unmute|(±)percent>
  --input-volume  <raise|lower|mute-toggle|mute|unmute|(±)percent>
  --brightness    <raise|lower|(±)percent>       [--device NAME]
  --playerctl     <play-pause|play|pause|stop|next|prev|shuffle>  [--player NAME]
  --custom-message TEXT   [--custom-icon NAME]
  --custom-progress 0..1  [--custom-progress-text TEXT]
  --custom-segmented-progress VALUE:SEGMENTS
  --caps-lock | --num-lock | --scroll-lock   [--*-led /sys/class/leds/NAME]
  --monitor NAME      which screen to draw on (default: the focused one)
  -d, --duration MS   how long to show it (default: 1000)
EOF
		exit 0
		;;
	--) shift; EXTRA+=("$@"); break ;;
	*) EXTRA+=("$1"); shift ;;
	esac
done

# A caller-set maximum overrides the default; swayosd takes both forms ("125"
# and "1.25") so either is accepted. awk, not python3: the same interpreter-start
# reasoning as everywhere else in this script.
if [ -n "$MAX_VOLUME_OPT" ]; then
	MAX_VOLUME=$(awk -v v="$MAX_VOLUME_OPT" 'BEGIN {
		f = v + 0
		if (v !~ /^[0-9.]+$/ || f <= 0) exit 1
		print (f <= 2) ? int(f * 100 + 0.5) : int(f + 0.5)
	}' 2>/dev/null || true)
	[ -n "${MAX_VOLUME:-}" ] || MAX_VOLUME="100"
fi

if [ -n "$MIN_BRIGHTNESS_OPT" ]; then
	MIN_BRIGHTNESS="${MIN_BRIGHTNESS_OPT#+}"
fi

# ── dispatch ─────────────────────────────────────────────────────────────────

# In swayosd's order of precedence: an explicit volume or brightness beats a
# custom message, which beats a lock indicator.
if [ -n "$OUTPUT_VOLUME" ]; then
	audio_osd "output-volume" "@DEFAULT_AUDIO_SINK@" "$OUTPUT_VOLUME"
elif [ -n "$INPUT_VOLUME" ]; then
	audio_osd "input-volume" "@DEFAULT_AUDIO_SOURCE@" "$INPUT_VOLUME"
elif [ -n "$BRIGHTNESS" ]; then
	brightness_osd "$BRIGHTNESS"
elif [ -n "$PLAYERCTL" ]; then
	playerctl_osd "$PLAYERCTL"
elif [ -n "$CUSTOM_MESSAGE" ] || [ -n "$CUSTOM_ICON" ] || [ -n "$CUSTOM_PROGRESS" ]; then
	label="$CUSTOM_MESSAGE"
	# --custom-progress-text replaces the message when a bar is drawn, the way
	# swayosd labels the bar rather than the window.
	[ -n "$CUSTOM_PROGRESS_TEXT" ] && label="$CUSTOM_PROGRESS_TEXT"
	send_spec "custom" "$CUSTOM_ICON" "$label" "$CUSTOM_PROGRESS" "" ""
elif [ "$CAPS_LOCK" = "1" ]; then
	lock_osd "caps" "$CAPS_LED"
elif [ "$NUM_LOCK" = "1" ]; then
	lock_osd "num" "$NUM_LED"
elif [ "$SCROLL_LOCK" = "1" ]; then
	lock_osd "scroll" "$SCROLL_LED"
else
	# Nothing to show: swayosd-client behaves the same way, but prints usage.
	exit 0
fi
