#!/usr/bin/env python3
"""Rebalance a pywal palette: dark neutral background, contrasty accents.
Self-contained: extracts colors, rebuilds palette, writes colors.json,
and regenerates templates -- all in one process without a scratch dir."""

import colorsys, json, os, re, subprocess, sys


def rgb2hex(rgb):
    return "#%02x%02x%02x" % tuple(int(round(c)) for c in rgb)


def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def to_hsv(rgb):
    r, g, b = (c / 255 for c in rgb)
    return colorsys.rgb_to_hsv(r, g, b)


def from_hsv(hsv):
    r, g, b = (int(round(c * 255)) for c in colorsys.hsv_to_rgb(*hsv))
    return rgb2hex((r, g, b))


def lighten(hexc, amt):
    return rgb2hex(tuple(c + (255 - c) * amt for c in hex2rgb(hexc)))


def hue_deg(hexc):
    return to_hsv(hex2rgb(hexc))[0] * 360


def hue_dist(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


def accent_score(hexc):
    hsv = to_hsv(hex2rgb(hexc))
    return hsv[1] * hsv[2]


def pick_accents(hexes, n=6, threshold=30, quality=0.6):
    """Pick accent colors with hue diversity."""
    cands = [h for h in hexes if to_hsv(hex2rgb(h))[2] >= 0.45]
    cands.sort(key=accent_score, reverse=True)
    rest = [h for h in hexes if h not in cands]
    rest.sort(key=lambda h: to_hsv(hex2rgb(h))[2], reverse=True)
    pool = cands + rest
    selected = [pool[0]]
    pool = pool[1:]
    for _ in range(n - 1):
        if not pool:
            break
        best_overall = max(pool, key=accent_score)
        far = [h for h in pool
               if min(hue_dist(hue_deg(h), hue_deg(s)) for s in selected) >= threshold]
        if far:
            best_far = max(far, key=accent_score)
            near = [h for h in pool if h not in far]
            near_best = accent_score(max(near, key=accent_score)) if near else 0.0
            if accent_score(best_far) >= quality * near_best:
                pick = best_far
            else:
                pick = best_overall
        else:
            pick = best_overall
        selected.append(pick)
        pool.remove(pick)
    return selected


def extract_all(img):
    """Single ImageMagick call: 16-color palette then 1x1 average.
    Splits on the IM header to parse each block separately."""
    out = subprocess.check_output(
        ["convert", img,
         "(", "+clone", "-resize", "25%", "-colors", "16",
         "-unique-colors", "+write", "txt:-", "+delete", ")",
         "-resize", "1x1!", "txt:-"],
        stderr=subprocess.DEVNULL,
    ).decode()

    blocks = out.split("# ImageMagick pixel enumeration:")
    # blocks[0] is empty (before first header), blocks[1] is 16-color, blocks[2] is 1x1
    if len(blocks) < 3:
        sys.exit("error: ImageMagick output parsing failed")

    hexes16 = re.findall(r"#[0-9A-Fa-f]{6}", blocks[1])
    avg_match = re.search(r"#[0-9A-Fa-f]{6}", blocks[2])
    if not hexes16 or not avg_match:
        sys.exit("error: failed to extract colors from image")

    return list(dict.fromkeys(hexes16))[:16], avg_match.group()


def main():
    img = sys.argv[1]
    cache_dir = os.path.expanduser("~/.cache/wal")
    colors_json = os.path.join(cache_dir, "colors.json")

    hexes, avg_color = extract_all(img)
    h_avg = to_hsv(hex2rgb(avg_color))[0]

    # Background: dominant hue, low saturation, very dark
    bg = from_hsv((h_avg, 0.18, 0.09))

    # Accents: vivid colors with hue diversity
    accents = pick_accents(hexes)

    palette = {"color0": bg}
    for i, c in enumerate(accents, 1):
        palette[f"color{i}"] = c
    palette["color7"] = lighten(bg, 0.55)
    palette["color8"] = lighten(bg, 0.35)
    palette["color15"] = lighten(bg, 0.75)
    for i, c in enumerate(accents, 9):
        palette[f"color{i}"] = lighten(c, 0.25)

    data = {
        "wallpaper": os.path.realpath(img),
        "alpha": "100",
        "colors": palette,
        "special": {
            "background": bg,
            "foreground": palette["color15"],
            "cursor": palette["color15"],
        },
    }

    os.makedirs(cache_dir, exist_ok=True)
    with open(colors_json, "w") as f:
        json.dump(data, f, indent=4)

    # Regenerate all templates from the rebalanced palette
    subprocess.run(["wal", "--theme", colors_json, "-n"], check=True)

    print(f"rebalanced: bg={bg}, accents={accents}")


if __name__ == "__main__":
    main()