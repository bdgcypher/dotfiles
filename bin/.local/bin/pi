#!/usr/bin/env bash

# Load colors
source "$HOME/.local/bin/fzf-colors"

# 1. Capture the selection from yay/fzf
pkgs=$(yay -Slq | fzf --multi \
  --header "Install Packages (ctrl-j/k: move, tab: select, esc: close)" \
  --preview "yay -Si {1}" \
  --preview-window=down:55% \
  --layout=reverse \
  --bind "ctrl-j:down,ctrl-k:up,tab:toggle")

# 2. Check if the user actually selected anything
if [ -z "$pkgs" ]; then
  echo "No packages selected. Exiting..."
  sleep 1
  exit 0
fi

# 3. Run the installation and check for success
if echo "$pkgs" | xargs -r yay -S --needed --noconfirm; then
  echo -e "\n\033[0;32mInstallation completed successfully!\033[0m"
  echo "Press any key to close..."
  read -n 1
else
  echo -e "\n\033[0;31mError: Installation failed.\033[0m"
  echo "Press any key to close..."
  read -n 1
fi
