#!/usr/bin/env bash

echo "Full System Update..."

# Run the update
if sudo pacman -Syu --noconfirm; then
  echo -e "\n\033[0;32mSystem update completed!\033[0m"
  echo "Press any key to close..."
  read -n 1
else
  echo -e "\n\033[0;31mError: System update failed.\033[0m"
  echo "Press any key to close..."
  read -n 1
fi
