#!/usr/bin/env bash

echo "Full System Update..."

# Run the update (debug packages ignored via IgnorePkg in pacman.conf)
if yay -Syu --noconfirm; then
  echo -e "\n\033[0;32mSystem update completed!\033[0m"

  # Remove orphaned dependencies
  orphans=$(yay -Qtdq)
  if [ -n "$orphans" ]; then
    echo -e "\nRemoving orphaned packages..."
    echo "$orphans" | xargs -r yay -Rns --noconfirm
    echo -e "\033[0;32mOrphan cleanup completed!\033[0m"
  else
    echo -e "\n\033[0;32mNo orphaned packages to clean.\033[0m"
  fi

  echo "Press any key to close..."
  read -n 1
  # Force the bar's update module to recheck, so the count does not sit at the
  # pre-update value until its next hourly poll. The shell watches this file;
  # anything that changes its contents fires the re-check.
  printf '%s\n' "$(date +%s)" > /tmp/cypher-updates.signal 2>/dev/null || true
else
  echo -e "\n\033[0;31mError: System update failed.\033[0m"
  echo "Press any key to close..."
  read -n 1
fi
