#!/usr/bin/env bash
# sunshine-display - create/remove a Hyprland headless output that matches the
# Moonlight client's resolution, for Sunshine's global prep command.
#
#   sunshine-display start    # Sunshine "do" prep command (stream starting)
#   sunshine-display stop     # Sunshine "undo" prep command (stream ended)
#   sunshine-display status   # show current state
#
# When Sunshine runs a prep command it exports the client's stream parameters as
# environment variables (SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS/HDR). Those are only
# present if the Moonlight client has "Optimize game settings for streaming"
# enabled; otherwise the fallbacks below are used.
#
# The physical display is deliberately left alone: SUNSHINE-1 is an independent,
# empty output that only Sunshine streams, so the local session keeps working
# unchanged while a client is connected.
#
# The command always exits 0 on purpose - Sunshine aborts the stream if a prep
# command fails, and a clear error from Sunshine's capture stage is more useful
# than an abort with no context.
set -uo pipefail

OUTPUT="${SUNSHINE_DISPLAY_OUTPUT:-SUNSHINE-1}"
FALLBACK_WIDTH="${SUNSHINE_DISPLAY_FALLBACK_WIDTH:-1920}"
FALLBACK_HEIGHT="${SUNSHINE_DISPLAY_FALLBACK_HEIGHT:-1080}"
FALLBACK_FPS="${SUNSHINE_DISPLAY_FALLBACK_FPS:-60}"

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
STATE_FILE="$RUNTIME/sunshine-display.state"
INHIBIT_PID_FILE="$RUNTIME/sunshine-display.inhibit.pid"
LOG_FILE="$RUNTIME/sunshine-display.log"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG_FILE" 2>/dev/null || true; }

have_hyprland() { command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; }

output_present() {
    if command -v jq >/dev/null 2>&1; then
        hyprctl monitors -j 2>/dev/null | jq -e --arg n "$OUTPUT" 'any(.[]; .name == $n)' >/dev/null 2>&1
    else
        hyprctl monitors 2>/dev/null | grep -q "^Monitor $OUTPUT "
    fi
}

positive_int() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) [ "$1" -gt 0 ] ;; esac; }

# Hyprland 0.56+ parses the config with its lua parser, where
# `hyprctl keyword monitor` is rejected ("keyword can't work with non-legacy
# parsers"); `hyprctl eval` is the supported equivalent. The legacy form is
# kept as a fallback for older Hyprland builds.
apply_mode() {
    local mode="$1"
    hyprctl eval \
        "hl.monitor({output=\"$OUTPUT\", mode=\"$mode\", position=\"auto-right\", scale=1})" \
        >/dev/null 2>&1 && return 0
    hyprctl keyword monitor "$OUTPUT,${mode},auto-right,1" >/dev/null 2>&1
}

current_mode() {
    command -v jq >/dev/null 2>&1 || return 0
    hyprctl monitors -j 2>/dev/null \
        | jq -r --arg n "$OUTPUT" '.[] | select(.name == $n) | "\(.width)x\(.height)"' 2>/dev/null
}

# Keep the machine awake while a client is connected. Without this, hypridle
# treats a stream as "idle" and suspend-then-hibernates mid-session on battery.
hold_inhibitor() {
    command -v systemd-inhibit >/dev/null 2>&1 || return 0
    [ -f "$INHIBIT_PID_FILE" ] && release_inhibitor
    systemd-inhibit --what=idle:sleep \
        --who=sunshine-display \
        --why="Moonlight stream in progress" \
        --mode=block sleep infinity >/dev/null 2>&1 &
    echo "$!" >"$INHIBIT_PID_FILE"
}

release_inhibitor() {
    [ -f "$INHIBIT_PID_FILE" ] || return 0
    local pid
    pid="$(cat "$INHIBIT_PID_FILE" 2>/dev/null || true)"
    if positive_int "$pid"; then kill "$pid" 2>/dev/null || true; fi
    rm -f "$INHIBIT_PID_FILE"
}

start() {
    local width height fps hdr

    width="${SUNSHINE_CLIENT_WIDTH:-}"
    height="${SUNSHINE_CLIENT_HEIGHT:-}"
    fps="${SUNSHINE_CLIENT_FPS:-}"
    hdr="${SUNSHINE_CLIENT_HDR:-false}"

    positive_int "$width" || width="$FALLBACK_WIDTH"
    positive_int "$height" || height="$FALLBACK_HEIGHT"
    positive_int "$fps" || fps="$FALLBACK_FPS"

    if ! have_hyprland; then
        log "start: hyprctl unavailable, nothing to do"
        exit 0
    fi

    # Idempotent: a leftover output from a crashed Sunshine instance is reused.
    if ! output_present; then
        hyprctl output create headless "$OUTPUT" >/dev/null 2>&1 \
            || log "start: 'hyprctl output create headless $OUTPUT' failed"
    fi

    # auto-right keeps the virtual output out of the way of the physical one.
    # HDR is intentionally not applied: Hyprland headless outputs are not a
    # reliable HDR target, and a bad bitdepth/cm rule can blank the output.
    apply_mode "${width}x${height}@${fps}"

    # Diagnose a silently-rejected mode instead of streaming the wrong size.
    local actual
    actual="$(current_mode)"
    if [ -n "$actual" ] && [ "$actual" != "${width}x${height}" ]; then
        log "start: $OUTPUT is ${actual}, requested ${width}x${height}@${fps}"
    fi

    printf '%sx%s@%s\n' "$width" "$height" "$fps" >"$STATE_FILE"
    hold_inhibitor
    log "start: $OUTPUT at ${width}x${height}@${fps} (client hdr=$hdr)"
    exit 0
}

stop() {
    release_inhibitor

    if have_hyprland && output_present; then
        hyprctl output remove "$OUTPUT" >/dev/null 2>&1 \
            || log "stop: failed to remove $OUTPUT"
    fi

    rm -f "$STATE_FILE"
    log "stop: $OUTPUT removed"
    exit 0
}

status() {
    if output_present; then
        printf '%s active at %s\n' "$OUTPUT" "$(cat "$STATE_FILE" 2>/dev/null || echo 'unknown mode')"
    else
        printf '%s not present\n' "$OUTPUT"
    fi
    if [ -f "$INHIBIT_PID_FILE" ]; then
        printf 'idle/sleep inhibitor held (pid %s)\n' "$(cat "$INHIBIT_PID_FILE")"
    fi
    return 0
}

case "${1:-}" in
    start)  start ;;
    stop)   stop ;;
    status) status ;;
    *)
        echo "Usage: $(basename "$0") {start|stop|status}" >&2
        exit 2
        ;;
esac
