#!/usr/bin/env bash
# hypr-firefox-pwa-remove — TUI remover for firefox web apps.
# fzf multi-select searchable list with keybinds bar.

set -uo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(dirname "$(realpath "$0")")")" && pwd)"
[ -d "$DOTFILES_DIR/hypr" ] || DOTFILES_DIR="$HOME/.dotfiles"
WINDOWS_LUA="$DOTFILES_DIR/hypr/.config/hypr/windows.lua"
APPS_LUA="$DOTFILES_DIR/hypr/.config/hypr/bindings/applications.lua"
KEYBINDS_TOML="$DOTFILES_DIR/elephant/.config/elephant/menus/keybinds.toml"
APPS_DIR="$HOME/.local/share/applications"
ICONS_DIR="$HOME/.local/share/icons"

# ── Draw a full-width keybinds bar at the top of the terminal ────────────
draw_keybinds_bar() {
  local rows cols
  read -r rows cols < <(stty size 2>/dev/null)
  cols=${cols:-100}
  {
    printf '\033[1;1H╭─ Remove Web App %s╮\n' "$(awk -v n=$((cols - 19)) 'BEGIN { for (i = 0; i < n; i++) printf "─" }')"
    printf '\033[2;1H│  ctrl-j/k: move     tab: select     enter: confirm     esc: close        %*s│\n' $((cols - 72)) ""
    printf '\033[3;1H╰%s╯\n' "$(awk -v n=$((cols - 2)) 'BEGIN { for (i = 0; i < n; i++) printf "─" }')"
  } >/dev/tty
}

# ── Scan for installed web apps ──────────────────────────────────────────
mapfile -t FILES < <(grep -l "Exec=hypr-firefox-pwa" "$APPS_DIR"/*.desktop 2>/dev/null || true)
if [ "${#FILES[@]}" -eq 0 ]; then
  echo "No installed web apps found."
  echo "Press any key to close..."
  read -n 1
  exit 0
fi

# Build display list: "app_name    (filename)" — fzf multi-select
display=()
for f in "${FILES[@]}"; do
  name=$(grep -m1 "^Name=" "$f" | cut -d= -f2-)
  base=$(basename "$f" .desktop)
  display+=("$name	$base")
done

# ── fzf multi-select ─────────────────────────────────────────────────────
read -r rows cols < <(stty size 2>/dev/null)
height_pct=$(( (rows - 5) * 100 / rows ))
[ "$height_pct" -lt 30 ] && height_pct=30

draw_keybinds_bar
printf '\033[4;1H' >/dev/tty

selected=$(
  printf '%s\n' "${display[@]}" |
    fzf \
      --multi \
      --height="${height_pct}%" \
      --border=rounded \
      --border-label="─ Web Apps ─" \
      --border-label-pos=2 \
      --color=border:-1,label:-1 \
      --prompt="Search> " \
      --layout=reverse \
      --delimiter="	" \
      --with-nth=1 \
      --bind "esc:abort" \
      --bind "ctrl-j:down" \
      --bind "ctrl-k:up" 2>/dev/tty
)

# ESC or empty → exit cleanly
[ -z "$selected" ] && { clear; exit 0; }

# ── Remove each selected app ─────────────────────────────────────────────
echo -e "\n\033[1;33mRemoving web apps...\033[0m"

SUCCESS=true
while IFS='	' read -r name safe_name; do
  [ -z "$name" ] && continue

  # Desktop file
  rm -f "$APPS_DIR/$safe_name.desktop" "$ICONS_DIR/$safe_name.png" 2>/dev/null || true

  # State file
  awk -F'\t' -v n="$name" '$1 != n' /tmp/hypr-firefox-pwa-state 2>/dev/null > /tmp/hypr-firefox-pwa-state.tmp && \
    mv /tmp/hypr-firefox-pwa-state.tmp /tmp/hypr-firefox-pwa-state 2>/dev/null || true

  # Window rule
  if grep -qsF -- "-- Web App: $name" "$WINDOWS_LUA"; then
    start=$(grep -nF -- "-- Web App: $name" "$WINDOWS_LUA" | cut -d: -f1 | head -1)
    if [ -n "$start" ]; then
      prev=$((start - 1))
      sed -n "${prev}p" "$WINDOWS_LUA" | grep -q '^$' && start=$prev
      end=$(awk -v s="$start" 'NR > s && /^\}$/ { print NR; exit }' "$WINDOWS_LUA")
      [ -n "$end" ] && sed -i "${start},${end}d" "$WINDOWS_LUA"
    fi
  fi

  # Keybind
  if grep -qsF -- "-- Web App Keybind: $name" "$APPS_LUA"; then
    start=$(grep -nF -- "-- Web App Keybind: $name" "$APPS_LUA" | cut -d: -f1 | head -1)
    if [ -n "$start" ]; then
      prev=$((start - 1))
      sed -n "${prev}p" "$APPS_LUA" | grep -q '^$' && start=$prev
      end=$(awk -v s="$start" 'NR > s && /^\)$/ { print NR; exit }' "$APPS_LUA")
      [ -n "$end" ] && sed -i "${start},${end}d" "$APPS_LUA"
    fi
  fi

  # Elephant keybinds
  if grep -qsF -- "$name" "$KEYBINDS_TOML"; then
    awk -v appname="$name" '
      /^\[\[entries\]\]$/ { block = $0 "\n"; in_block = 1; keep = 1; next }
      in_block {
        block = block $0 "\n"
        if (index($0, "text = ") && index($0, appname)) keep = 0
        if ($0 == "") {
          if (keep) printf "%s", block
          block = ""; in_block = 0
        }
        next
      }
      { print }
      END { if (in_block && keep) printf "%s", block }
    ' "$KEYBINDS_TOML" > "$KEYBINDS_TOML.tmp" && mv "$KEYBINDS_TOML.tmp" "$KEYBINDS_TOML"
    sed -i ':a; /^\n*$/{$d; N; ba}' "$KEYBINDS_TOML"
    printf '\n' >> "$KEYBINDS_TOML"
  fi

  echo "Removed $name"
done <<< "$selected"

# ── Result ───────────────────────────────────────────────────────────────
if [ "$SUCCESS" = true ]; then
  echo -e "\n\033[0;32mWeb App removal successful!\033[0m"
else
  echo -e "\n\033[0;31mWeb App removal failed.\033[0m"
fi
echo "Press any key to close..."
read -n 1

# Reload hypr, then restart elephant + walker in their own systemd unit so
# the elephant restart cannot kill walker (this script runs in elephant's cgroup).
hyprctl reload >/dev/null 2>&1 || true
systemd-run --user --quiet --collect -- bash -c 'systemctl --user restart elephant.service || true; killall -9 walker 2>/dev/null || true; exec walker --gapplication-service' >/dev/null 2>&1 || true
