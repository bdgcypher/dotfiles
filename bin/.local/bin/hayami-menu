#!/usr/bin/env bash
# hayami-menu - one entry point for the launcher.
#
#   hayami-menu -m menus:system/power --width 250   open a launcher mode
#   hayami-menu                                     open the main menu, or close
#                                                   it again if it is already up
#   hayami-menu --dmenu                             pick from stdin
#   hayami-menu --close                             close it
#   hayami-menu --refresh                           re-read the menu definitions
#
# The launcher itself is hayami-shell's. This only speaks to it over its IPC
# socket, so a keybind, a script or a menu entry never has to know how the
# launcher is built.
#
# The option names are walker's, which is where they came from -- the keybinds
# and the scripts in this repo were written against walker's CLI, and keeping
# the spellings meant none of them had to change when the launcher did. The
# menu TOMLs still navigate with `hayami-menu -m ...` / `hayami-menu --close`,
# which the launcher recognises and answers in-process.

set -uo pipefail

SHELL_ID="hayami-shell"
IPC_TARGET="launcher"

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
MENUS_SCRIPT="$HOME/.config/quickshell/$SHELL_ID/scripts/menus-json.py"
PROVIDERS_SCRIPT="$HOME/.config/quickshell/$SHELL_ID/scripts/providers-json.py"
DMENU_DIR="$RUNTIME/hayami-menu"

usage() {
	cat >&2 <<'EOF'
usage:
  hayami-menu [options]                open the launcher; closes it instead if
                                       it is already up and no provider was
                                       named (--keepopen forces it open)
      -m, --provider PROVIDER          exclusive provider, e.g. menus:system/power
      -s, --set SET                    provider set
      -t, --theme THEME                theme (default, keybinds)
      -w, --width N                    box width
      -h, --height N                   box height
      -p, --placeholder TEXT           input placeholder
      -n, --nosearch                   hide the search input
      -N, --nohints                    hide the hint bar
      -d, --dmenu                      dmenu: read lines from stdin, print the pick
      -i, --index                      dmenu: print the index instead of the value
      -x, --password                   dmenu: password input
      -q, --close                      close the launcher
      --refresh                        re-read the menu definitions
EOF
}

# ── talking to the shell ─────────────────────────────────────────────────────

# Delivers one call. `qs ipc` exits non-zero and starts nothing when no instance
# of the shell is running, but a missing IPC target is reported as text with
# exit 0, so the output has to be checked as well.
ipc() {
	local out
	out=$(qs ipc -c "$SHELL_ID" call "$IPC_TARGET" "$@" 2>&1) || return 1
	case "$out" in
	*"Target not found"* | *"Could not find"* | *"No running instances"* | *"Too few arguments"*) return 1 ;;
	esac
	return 0
}

# The shell is the only thing that can draw the launcher, so when it is not
# answering there is nothing to fall back to: say so plainly instead of failing
# silently, which is what a missing launcher used to look like.
no_shell() {
	echo "hayami-menu: hayami-shell is not running (try 'hayami-shell start')" >&2
	exit 1
}

# ── argument parsing ─────────────────────────────────────────────────────────

MODE="" SET="" THEME="" WIDTH="" HEIGHT="" PLACEHOLDER=""
NOSEARCH=0 NOHINTS=0 DMENU=0 INDEX=0 PASSWORD=0 CLOSE=0 KEEPOPEN=0

while [ $# -gt 0 ]; do
	case "$1" in
	--refresh)
		for script in "$MENUS_SCRIPT" "$PROVIDERS_SCRIPT"; do
			[ -r "$script" ] || {
				echo "hayami-menu: $script not found" >&2
				exit 1
			}
			python3 "$script"
		done
		# The shell watches both caches and the clipboard history, so nothing has
		# to be restarted for the new content to show up.
		ipc reload >/dev/null 2>&1 || true
		exit 0
		;;
	-m | --provider) MODE="${2:-}"; shift 2 ;;
	-s | --set) SET="${2:-}"; shift 2 ;;
	-t | --theme) THEME="${2:-}"; shift 2 ;;
	-w | --width) WIDTH="${2:-}"; shift 2 ;;
	-h | --height) HEIGHT="${2:-}"; shift 2 ;;
	-p | --placeholder) PLACEHOLDER="${2:-}"; shift 2 ;;
	-n | --nosearch) NOSEARCH=1; shift ;;
	-N | --nohints) NOHINTS=1; shift ;;
	-d | --dmenu) DMENU=1; shift ;;
	-i | --index) INDEX=1; shift ;;
	-x | --password) PASSWORD=1; DMENU=1; shift ;;
	-q | --close) CLOSE=1; shift ;;
	-k | --keepopen) KEEPOPEN=1; shift ;; # open even if the launcher is already up
	-c | --current | -e | --exit | -H | --hideqa) shift ;; # accepted, no-op here	--) shift; break ;;
	-*) echo "hayami-menu: unknown option $1" >&2; usage; exit 2 ;;
	*) shift ;; # a positional provider name: accepted, the shell takes none
	esac
done

# ── close ────────────────────────────────────────────────────────────────────

if [ "$CLOSE" = "1" ]; then
	ipc close >/dev/null 2>&1 || no_shell
	exit 0
fi

# ── dmenu ────────────────────────────────────────────────────────────────────

if [ "$DMENU" = "1" ]; then
	PAYLOAD=$(cat)

	# Hand the list over, then block on a FIFO so the caller still gets the pick
	# on stdout, the way a dmenu call is expected to behave.
	mkdir -p "$DMENU_DIR"
	FIFO="$DMENU_DIR/pick.$$"
	rm -f "$FIFO"
	mkfifo "$FIFO" 2>/dev/null || no_shell

	# The payload goes across as a plain argv entry: newlines survive fine, which
	# avoids an encode/decode round trip on both sides.
	if ! ipc dmenu "$PAYLOAD" "$FIFO" "$INDEX" "$PASSWORD" "$PLACEHOLDER" >/dev/null; then
		rm -f "$FIFO"
		no_shell
	fi

	PICK=""
	read -r -t 300 PICK <"$FIFO" || PICK=""
	rm -f "$FIFO"
	[ -n "$PICK" ] && printf '%s\n' "$PICK"
	exit 0
fi

# ── open ─────────────────────────────────────────────────────────────────────

OPTS=$(printf '{"mode":"%s","set":"%s","theme":"%s","width":"%s","height":"%s","placeholder":"%s","nosearch":%s,"nohints":%s}' \
	"$MODE" "$SET" "$THEME" "$WIDTH" "$HEIGHT" "$PLACEHOLDER" "$NOSEARCH" "$NOHINTS")

# A bare invocation toggles, which is what the SUPER key needs: press it to open
# the main menu, press it again to close. Naming a provider still switches the
# open launcher in place, so SUPER+. / SUPER+K / SUPER+ESC never close it, and
# --keepopen forces the open behaviour.
if [ -z "$MODE" ] && [ -z "$SET" ] && [ "$KEEPOPEN" != "1" ]; then
	LAUNCH=toggle
else
	LAUNCH=open
fi

# The call is the probe as well as the action, which keeps a launch to a single
# `qs` invocation -- a `pgrep -f` probe first would cost ~250ms on a busy session,
# because it reads every /proc entry, and that was the launcher's opening delay.
ipc "$LAUNCH" "$OPTS" >/dev/null || no_shell
