#!/usr/bin/env bash

# Toggle dictation, with the same on-screen feedback as the screen recorder.
#
# The keybind (SUPER+D) and the Waybar module's click call this instead of
# `voxtype record toggle` directly, so the OSD follows the daemon's real state.
# voxtype has no hook/exec setting of its own, so it cannot drive SwayOSD.

ICON="audio-input-microphone"

# The daemon writes idle/recording/transcribing here (state_file = "auto").
STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype/state"

# On-screen overlay helper: hayami-osd draws it through the Quickshell shell,
# with notify-send as the last resort for a session where the shell is not
# running at all.
show_osd() {
  local msg="$1"
  if command -v hayami-osd &>/dev/null; then
    hayami-osd --custom-message "$msg" --custom-icon "$ICON"
  else
    notify-send "Dictation" "$msg" -i "$ICON" -t 2000 -a "voxtype-dictate"
  fi
}

read_state() {
  head -c 32 "$STATE_FILE" 2>/dev/null | tr -d '\n'
}

# A muted capture source hands the daemon pure silence, and its voice activity
# detection then finds no speech in that silence, so the recording transcribes to
# nothing at all. Nothing about that failure is visible from the outside: the OSD
# reports started, the bar shows recording, and the text simply never appears --
# which looks exactly like dictation being broken.
#
# So refuse to start and say why, rather than appearing to listen to nothing.
# Refusing is the right call because the alternative cannot succeed; a user who
# wants to dictate while muted has to unmute regardless.
#
# This assumes voxtype records from the default source, which is what
# audio.device = "default" in the config means. wpctl rather than pactl because it
# reads the default source directly and is what the rest of the audio tooling here
# uses; it reports mute as a "[MUTED]" tag on the volume line.
#
# If the check cannot be made -- wpctl missing, no default source, an older
# wpctl that omits the tag -- this stays quiet and dictation is attempted, which
# is the old behaviour rather than a new way to fail.
mic_muted() {
  wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q 'MUTED'
}

before="$(read_state)"

# No state file means the daemon isn't running. Nothing to toggle or report.
[ -n "$before" ] || exit 1

if mic_muted; then
  show_osd "Microphone Muted"
  exit 1
fi

voxtype record toggle >/dev/null 2>&1 || exit 1

# The daemon updates the state file asynchronously, so wait for it to settle
# before deciding which way the toggle went.
after="$before"
for _ in $(seq 1 30); do
  after="$(read_state)"
  [ "$after" != "$before" ] && break
  sleep 0.05
done

# recording -> we just started. Anything else (transcribing, or straight back to
# idle when VAD drops a recording that contained no speech) means we stopped.
# An unchanged state means the daemon ignored the toggle (e.g. pressed again
# mid-transcription), so show nothing rather than a misleading message.
if [ "$after" = "recording" ]; then
  show_osd "Dictation Started"
elif [ "$after" != "$before" ]; then
  show_osd "Dictation Stopped"
fi
