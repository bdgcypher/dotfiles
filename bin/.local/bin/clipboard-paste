#!/usr/bin/env bash
# clipboard-paste - Wait for the launcher to close, then paste the clipboard
# contents into the focused window. Handles text, image, and file (uri-list)
# entries - the target app decides how to handle the pasted content.
#
# This is what SUPER+V runs, and what every entry in the clipboard history menu
# (SUPER+CTRL+V) runs, so both paste the same way. The chord is picked here
# rather than in the keybind because it depends on what the focused window is,
# and a keybind cannot ask that.

# The launcher's files provider appends "-t 'text/uri-list'" for file entries.
# The hint lands on this script, while wl-copy (first in the chain) copied the
# URIs as plain text. Re-copy with the correct MIME type so apps see real file
# URIs.
if [ "$1" = "-t" ] && [ "$2" = "text/uri-list" ]; then
  wl-paste 2>/dev/null | wl-copy -t 'text/uri-list'
fi

# The launcher renders as hayami-shell's own layer surface, quickshell:launcher.
# Poll until it is off screen, i.e. the picker closed and focus has gone back to
# the window we are pasting into.
for _ in $(seq 1 40); do
  ns=$(hyprctl layers -j 2>/dev/null | jq -r '.. | objects | .namespace? // empty' 2>/dev/null)
  if ! printf '%s\n' "$ns" | grep -qxE 'quickshell:launcher'; then
    break
  fi
  sleep 0.05
done

# Settling time for focus to fully return.
sleep 0.1

# Ghostty drops synthetic pastes that contain newlines - type those instead.
#
# Only for a clipboard that actually holds text. wl-paste with no -t falls back
# to whatever type the source offers, so an image entry comes back as the raw
# PNG (44 KB of it, NUL bytes dropped by the shell) - which "contains newlines"
# and would otherwise be typed into the focused terminal as garbage instead of
# being pasted as an image.
if wl-paste --list-types 2>/dev/null | grep -qE '^text/|^(TEXT|STRING|UTF8_STRING)$'; then
  text=$(wl-paste 2>/dev/null)
  cls=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class' 2>/dev/null)
  case "$text" in
    *$'\n'*)
      if printf '%s' "$cls" | grep -q ghostty; then
        printf '%s' "$text" | wtype -
        exit 0
      fi
      ;;
  esac
fi

# Real paste. The chord is chosen from what the focused window actually is.
#
# A terminal gets Ctrl+Shift+V. That is the chord terminal emulators bind as
# their paste -- ghostty, kitty, foot, alacritty, konsole all do -- and it asks
# the emulator to paste the clipboard itself. Shift+Insert is the odd one out
# here: ghostty binds it, but most other emulators do not, and an unbound chord
# does nothing at all, which is indistinguishable from a broken paste.
#
# Everything else gets Shift+Insert, which is the X11 standard paste and is bound
# by GTK and Qt, so browsers, editors and file managers paste on their own.
#
# The test is Hyprland's own `terminal` tag rather than a list of class names,
# because that tag is what the desktop already uses to decide what a terminal is
# (see hypr/apps/terminals.lua). A terminal added there later becomes correct
# here without this file being edited.
#
# The trailing "*" is stripped first, and that is not tidiness. Hyprland marks
# the *current* tag with it, so a focused ghostty reports
# ["default-opacity*", "terminal*"] and an exact match on "terminal" misses --
# which sends a terminal paste chord to a browser instead. A fixture with clean
# tags hid it; only the real window showed it.
is_terminal=$(hyprctl activewindow -j 2>/dev/null |
  jq -r '(.tags // []) | map(sub("\\*$"; "")) | index("terminal") != null' 2>/dev/null)
[ "$is_terminal" = "true" ] || is_terminal=false

if [ "$is_terminal" = true ]; then
  hyprctl eval "hl.dispatch(hl.dsp.send_shortcut({ window = 'activewindow', mods = 'CTRL SHIFT', key = 'v' }))" \
    >/dev/null 2>&1
else
  # Left as it was, on the string form, because that is the form this chord has
  # always been sent with and it is the one SUPER+V has been shipping.
  hyprctl dispatch 'hl.dsp.send_shortcut({ mods = "SHIFT", key = "Insert" })'
fi
