#!/usr/bin/env bash

# Clear terminal
clear

# -r: Backslashes won't be escaped
# -s: Secret mode (input is invisible)
# -p: Custom prompt string
read -r -s -p "SUU VPN Password: " PASS

# If PASS is empty (User hit Enter without typing or hit Ctrl+C)
if [ -z "$PASS" ]; then
  echo -e "\n"
  notify-send "Global Protect" "Connection Cancelled" \
    --icon=information \
    --hint=int:transient:1 \
    -t 2000
  exit 0
fi

# Clear again to hide the prompt text once Enter is pressed
clear

# Pipe password to openconnect
# Redirect output to /dev/null to keep ui clean
if echo "$PASS" | sudo openconnect --protocol=gp \
  --server=https://vpn.suu.edu \
  --user=benjamingoddard \
  --no-dtls \
  --passwd-on-stdin -b >/dev/null 2>&1; then

  notify-send "Global Protect" "VPN Connected" \
    --icon=network-vpn \
    --hint=int:transient:1 \
    -t 2300
else
  notify-send "Global Protect" "VPN Connection Failed" \
    --icon=network-error \
    --hint=int:transient:1 \
    -t 2300
fi
