#!/usr/bin/env bash

clear
read -r -s -p "SUU VPN Password: " PASS

if [ -z "$PASS" ]; then
  echo -e "\n"
  notify-send "Global Protect" "Connection Cancelled" \
    --icon=information \
    --hint=int:transient:1 \
    -t 2000
  exit 0
fi

clear

# Connect directly to the gateway usergroup to bypass double-auth
if echo "$PASS" | sudo openconnect --protocol=gp \
  --server=vpn.suu.edu \
  --usergroup=gateway \
  --user=benjamingoddard \
  --no-dtls \
  --passwd-on-stdin -b >/dev/null 2>&1; then

  notify-send "Global Protect" "VPN Connected" \
    --icon=network-vpn \
    --hint=int:transient:1 \
    -t 2300
else
  notify-send "Global Protect" "VPN Connection Failed" \
    --icon=network-error \
    --hint=int:transient:1 \
    -t 2300
fi
