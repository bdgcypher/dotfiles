#!/usr/bin/env bash

# Run tailscale up with passwordless sudo
if sudo tailscale up >/dev/null 2>&1; then

  notify-send "Tailscale" "VPN Connected" \
    --icon=network-vpn \
    --hint=int:transient:1 \
    --expire-time=2300
else
  notify-send "Tailscale" "VPN Connection Failed" \
    --icon=network-error \
    --hint=int:transient:1 \
    --expire-time=2300
fi
