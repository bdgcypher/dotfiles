#!/usr/bin/env bash
# hayami-agent -- the freebuff coding agent: start it, and read what it is doing.
#
#   hayami-agent new        open a new agent window (asks for the directory)
#   hayami-agent new <dir>  open one in <dir>, without asking
#   hayami-agent panel      toggle the bar's agent popout
#   hayami-agent status     the merged reading (session + Freebucks)
#   hayami-agent refresh    re-read it, bypassing the API cache
#   hayami-agent session    the raw Freebucks/session payload
#   hayami-agent streak     the raw daily-streak payload
#
# `new` always spawns a new window. It used to be focus-or-spawn, but a second
# agent session is a thing you want to be able to open *while* one is already
# running -- two directories, two conversations -- and a toggle cannot do both
# jobs at once. Focus still happens, from the panel: each session's row carries
# the window agent-status.sh matched to it, so the window you want is one click
# away without costing the key its ability to open another.
#
# `new` also asks *where* before it starts, in a floating yazi, because the
# directory is the thing the session is about: freebuff names its conversation
# after it, and the panel's row shows it. pick_directory() below says why that
# is a window of its own and how the answer gets back out of it.
#
# `--title` is not for finding the window from here -- that lookup is gone -- it
# is how `agent-status.sh` recognises an agent window and matches it to a
# session, so the panel can hand the focus to it. That script matches on
# `initialTitle`, so the flag has to keep setting it.
#
# Ghostty's `title` is a *forced* title: it pins the window to that value and
# ignores the OSC escapes a program inside would otherwise send. Measured, both
# directions, with a script that rewrites its own title from within:
#
#   with --title=Freebuff    title=Freebuff  initialTitle=Freebuff  (rewrite ignored)
#   without --title          title=<the program's>  initialTitle=Ghostty
#
# Which is why `initialTitle` holds `Freebuff` for the life of the window: the
# freebuff TUI setting its own title cannot take the window out from under the
# panel's match either. Dropping `--title` would not merely rename the window, it
# would cost every session its focus target.
#
# The API verbs are read-only. Do not add one that spends or reserves anything
# (see AGENTS.md).

set -uo pipefail

SHELL_ID="hayami-shell"
SHELL_DIR="$HOME/.config/quickshell/$SHELL_ID"
# bin/.local/bin/<this> is three levels under the repo root.
REPO_DIR="$(cd "$(dirname "$(realpath "$0")")/../../.." 2>/dev/null && pwd || echo "$HOME/.dotfiles")"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/manicode"
API="https://www.codebuff.com"
WINDOW_TITLE="Freebuff"

# The shell's own script, looked up in $HOME first and in the repo second --
# `hayami-agent new` can be called before a restow has run, and the repo copy is
# the same file.
status_script() {
	if [ -x "$SHELL_DIR/scripts/agent-status.sh" ]; then
		printf '%s\n' "$SHELL_DIR/scripts/agent-status.sh"
	elif [ -x "$REPO_DIR/quickshell/.config/quickshell/$SHELL_ID/scripts/agent-status.sh" ]; then
		printf '%s\n' "$REPO_DIR/quickshell/.config/quickshell/$SHELL_ID/scripts/agent-status.sh"
	fi
}

die() {
	echo "hayami-agent: $1" >&2
	exit "${2:-1}"
}

usage() {
	cat >&2 <<'EOF'
usage: hayami-agent <verb>

  new [dir]  open a new agent window; asks for the directory with yazi when
             none is given
  panel      toggle the bar's agent popout
  status     the merged reading (local session + Freebucks)
  refresh    re-read it, bypassing the 60s API cache
  session    the raw Freebucks/session payload
  streak     the raw daily-streak payload
EOF
}

# ── starting it ──────────────────────────────────────────────────────────────
#
# A floating yazi, the same window the desktop's own file chooser is (class
# `floating.FilePicker`, so it inherits the float/centre/size rule in
# hypr/windows.lua instead of needing a rule of its own).
#
# **Enter is the answer**, and a yazi plugin is what gives it:
# yazi/.config/yazi/plugins/hayami-pick.yazi, bound to `<Enter>` in keymap.toml.
# It writes the directory under the cursor here and quits, and falls back to the
# stock `open` whenever HAYAMI_AGENT_PICK is unset -- so a yazi opened by hand
# still opens things on Enter rather than quitting at them.
#
# The plugin writes this file and nothing else does. yazi's own `--cwd-file`
# cannot be the answer: measured, it is written when yazi is killed too, so a
# closed picker window would read as "they chose whatever directory they
# happened to be in" and start a session nobody asked for. A closed window, or
# `q`, leaves the file empty and starts nothing -- which is the cancel it should
# be.
#
# The title carries no provider name on purpose. agent-status.sh finds a
# session's window by its title, and a picker called "Freebuff" would be read as
# an agent window that has not run a step yet -- a tier-0 focus target for an
# idle session.
#
# `-e` forces ghostty to be its own instance and to quit when the command does,
# so this blocks until the window is gone; that is what makes reading the result
# afterwards possible at all.

pick_directory() {
	local pick_dir result dir=""

	pick_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/hayami-agent-pick.XXXXXX") || return 1
	result="$pick_dir/result"

	HAYAMI_AGENT_PICK="$result" ghostty --class=floating.FilePicker \
		--title="Agent: choose a directory (Enter = start, q = cancel)" \
		--working-directory="$HOME" \
		-e yazi >/dev/null 2>&1

	[ -s "$result" ] && dir=$(cat "$result")
	rm -rf "$pick_dir"

	[ -n "$dir" ] || return 1
	printf '%s' "$dir"
}

do_new() {
	local dir="${1:-}"

	# Always a new window: no lookup, no focus-or-spawn. The key's whole job is
	# to open another session, and a second one is a normal thing to want while
	# the first is still running -- see the note at the top of this file.
	#
	# Where it starts is the picker's answer. No argument is the normal path,
	# shared by the menu entry and SUPER+SHIFT+A; a directory argument is the
	# scripted one, which is also how this file starts a session without the
	# floating step in the way.
	if [ -z "$dir" ]; then
		command -v ghostty >/dev/null 2>&1 || die "ghostty not found"
		command -v yazi >/dev/null 2>&1 || die "yazi not found"
		# Cancelled, not failed: the picker closes itself either way, and
		# nothing here should print at someone who changed their mind.
		dir=$(pick_directory) || return 0
	fi
	[ -d "$dir" ] || die "not a directory: $dir"

	# Tile, not float: an agent session is something you work in, not a dialog
	# over what you were doing. The class is left alone so the window keeps the
	# terminal rules in hypr/apps/terminals.lua; `--title` is what lets
	# agent-status.sh match the window to this session afterwards, so the panel
	# can focus it -- not something for this script to find it by.
	uwsm-app -- ghostty --title="$WINDOW_TITLE" --working-directory="$dir" -e freebuff \
		>/dev/null 2>&1 &
}

# ── the panel ────────────────────────────────────────────────────────────────

do_panel() {
	local on="${1:-toggle}"
	command -v hayami-bar >/dev/null 2>&1 || die "hayami-bar not found (is the bin package stowed?)"
	hayami-bar agent "$on"
}


# ── the reading ──────────────────────────────────────────────────────────────

run_status() {
	local script
	script=$(status_script)
	[ -n "$script" ] || die "agent-status.sh not found"
	"$script" "$@"
}

# The payloads are one long line; pretty-print them for a human, and fall back to
# the raw text when jq is not there rather than printing nothing.
pretty() {
	if command -v jq >/dev/null 2>&1; then
		jq . 2>/dev/null || cat
	else
		cat
	fi
}

# The CLI's bearer token, wherever this version of it keeps one -- read the same
# way agent-status.sh reads it, deliberately, so the bar cannot say "logged in"
# while this says to run `freebuff login`.
#
# The file is tried first because older builds wrote the token into it as
# `authToken`. 0.2.27 does not: credentials.json keeps only
# `tokenStore: "keychain"`, and the token itself goes to the Secret Service
# under `service=freebuff-cli account=<the credentials file>`, which is what the
# entry's own label spells. Read at call time and never echoed.
#
# `timeout` bounds a *locked* keyring, which answers by putting a prompt on
# screen rather than by failing -- a plain `session` read should not hang there.
read_token() {
	local token
	token=$(jq -r '.default.authToken // empty' "$CONFIG/credentials.json" 2>/dev/null)
	if [ -z "$token" ] && command -v secret-tool >/dev/null 2>&1; then
		token=$(timeout 3 secret-tool lookup service freebuff-cli account "$CONFIG/credentials.json" 2>/dev/null)
	fi
	printf '%s' "$token"
}

# One authenticated read-only GET. A 401 is reported as what it is rather than
# as an empty account.
api_get() {
	local path="$1" token
	token=$(read_token)
	[ -n "$token" ] || die "not logged in to freebuff (run 'freebuff login')"

	local body
	body=$(curl -sS --max-time 10 -H "Authorization: Bearer $token" "$API$path" 2>/dev/null) ||
		die "could not reach $API"

	if jq -e '.error == "unauthorized"' >/dev/null 2>&1 <<<"$body"; then
		die "the stored freebuff token was rejected (run 'freebuff login')"
	fi

	printf '%s\n' "$body"
}

# ── entry ────────────────────────────────────────────────────────────────────

case "${1:-}" in
new) do_new "${2:-}" ;;
panel) do_panel "${2:-toggle}" ;;
status) run_status | pretty ;;
refresh) run_status --refresh | pretty ;;
session) api_get "/api/v1/freebuff/session" | pretty ;;
streak) api_get "/api/v1/freebuff/streak" | pretty ;;
"") usage; exit 1 ;;
-h | --help) usage ;;
*)
	echo "hayami-agent: unknown command '$1'" >&2
	usage
	exit 2
	;;
esac
