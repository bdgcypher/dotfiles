#!/usr/bin/env bash

# Check if tailscale is active before disconnecting
if tailscale status >/dev/null 2>&1; then

  # Run tailscale down with passwordless sudo
  if sudo tailscale down >/dev/null 2>&1; then
    # Send disconnect notification
    notify-send "Tailscale" "VPN Disconnected" \
      --icon=network-error \
      --hint=int:transient:1 \
      --expire-time=2300
  else
    notify-send "Tailscale" "Disconnect Failed" \
      --icon=network-error \
      --hint=int:transient:1 \
      --expire-time=2300
  fi

else
  # Send no VPN notification if tailscale status was already offline/down
  notify-send "Tailscale" "No VPN Active" \
    --icon=network-error \
    --urgency=low \
    --hint=int:transient:1 \
    --expire-time=2300
fi
