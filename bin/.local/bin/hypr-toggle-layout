#!/usr/bin/env bash
# Toggle the active workspace's layout between dwindle and scrolling.

# On-screen overlay helper: hayami-osd draws it through the Quickshell shell.
# notify-send is the last resort, for a session where the shell is not running at
# all (a bare Hyprland, or the split second around a restart).
show_osd() {
  local msg="$1"
  if command -v hayami-osd &>/dev/null; then
    hayami-osd --custom-message "$msg" --custom-icon "view-grid-symbolic"
  else
    notify-send "Workspace layout" "$msg" -i "view-grid-symbolic" -t 2000 -a "hypr-toggle-layout"
  fi
}

ws="$(hyprctl activeworkspace -j 2>/dev/null)"
name="$(printf '%s' "$ws" | jq -r '.name')"
current="$(printf '%s' "$ws" | jq -r '.tiledLayout')"

case "$current" in
  dwindle) new="scrolling" ;;
  *)       new="dwindle" ;;
esac

hyprctl eval "hl.workspace_rule({ workspace = 'name:$name', layout = '$new' })"

# Poke the bar. It watches this file because Hyprland publishes no event when a
# workspace's layout changes (verified against its event socket -- a toggle emits
# nothing at all, so there is no event for the bar to subscribe to). The file's
# contents are only there to make the last change legible when debugging;
# FileView fires on any change, including the same value written again.
printf '%s\n' "$new" > /tmp/hypr-bar.signal 2>/dev/null || true

show_osd "Workspace $name layout: $new"
