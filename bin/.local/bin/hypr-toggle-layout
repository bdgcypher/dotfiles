#!/usr/bin/env bash
# Toggle the active workspace's layout between dwindle and scrolling.

# On-screen overlay helper: hayami-osd draws it through the Quickshell shell.
# notify-send is the last resort, for a session where the shell is not running at
# all (a bare Hyprland, or the split second around a restart).
show_osd() {
  local msg="$1"
  if command -v hayami-osd &>/dev/null; then
    hayami-osd --custom-message "$msg" --custom-icon "view-grid-symbolic"
  else
    notify-send "Workspace layout" "$msg" -i "view-grid-symbolic" -t 2000 -a "hypr-toggle-layout"
  fi
}

ws="$(hyprctl activeworkspace -j 2>/dev/null)"
id="$(printf '%s' "$ws" | jq -r '.id')"
name="$(printf '%s' "$ws" | jq -r '.name')"
current="$(printf '%s' "$ws" | jq -r '.tiledLayout')"

case "$current" in
  dwindle) new="scrolling" ;;
  *)       new="dwindle" ;;
esac

# Address the workspace by id, and only by name when it has no usable id. A
# numbered workspace is id 1, not `name:1`: a `name:` rule is stored, the eval
# still prints `ok`, and no workspace ever adopts the layout -- which is how
# this toggle used to do nothing at all. Named and special workspaces have a
# zero or negative id, and their name is their selector (`special:minimized`).
case "$id" in
  ''|null|0|-*) selector="$name" ;;
  *)            selector="$id" ;;
esac

hyprctl eval "hl.workspace_rule({ workspace = '$selector', layout = '$new' })"

# Read the layout back rather than reporting what was asked for: `hyprctl eval`
# prints `ok` for a rule that matched nothing, so the request is no evidence of
# what happened. The OSD and the bar both get the state Hyprland reports, which
# is what makes a silent failure visible instead of indistinguishable from a
# successful toggle.
actual="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.tiledLayout')"
[ -n "$actual" ] && [ "$actual" != "null" ] || actual="unknown"

# Poke the bar. It watches this file because Hyprland publishes no event when a
# workspace's layout changes (verified against its event socket -- a toggle emits
# nothing at all, so there is no event for the bar to subscribe to). The file's
# contents are only there to make the last change legible when debugging;
# FileView fires on any change, including the same value written again.
printf '%s\n' "$actual" > /tmp/hypr-bar.signal 2>/dev/null || true

show_osd "Workspace $name layout: $actual"
