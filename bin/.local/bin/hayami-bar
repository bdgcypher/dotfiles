#!/usr/bin/env bash
# hayami-bar -- move the bar to another edge, and switch its modules on and off.
#
#   hayami-bar position bottom      move the bar to an edge
#   hayami-bar toggle clock         switch one module on or off
#   hayami-bar show tray            switch one on, or off
#   hayami-bar hide tray
#   hayami-bar cluster status off   a whole cluster (status, time, layout)
#   hayami-bar all                  show every module again
#   hayami-bar keyboard toggle      drive the bar from the keyboard
#   hayami-bar state                print the bar's state as JSON
#
# The bar belongs to hayami-shell; this only speaks to it over the same IPC
# socket hayami-menu does, so a launcher entry never has to know how the bar is
# built. The bar can also be *dragged* to another edge -- see Bar.qml -- and both
# roads end in the same state, saved in one place.
#
# ── why it says what it did ─────────────────────────────────────────────────
#
# A menu entry that moves the bar is answered by the bar itself -- the bar is
# suddenly somewhere else, and that is the whole feedback -- so a move says
# nothing at all.
#
# A menu entry that switches a module off is different: the module is on a bar
# that may be on another screen's edge, or hidden behind a window, and the only
# clue that the click landed would be a small gap in a row of icons. So every
# switch draws an OSD saying which way it went -- the same OSD the volume keys
# use, through hayami-osd, which is where "what a user action looks like on
# screen" already lives.
#
# ── the keyboard ─────────────────────────────────────────────────────────────
#
# `keyboard` is the odd one out: it says nothing and switches nothing, because
# what it changes is where the keys go. It is the way into the bar's keyboard
# mode -- the keybind, and the launcher's keybind menu, both call it -- and the
# bar draws the only confirmation worth having, a ring around the module the
# keyboard is on:
#
#   arrows, or hjkl      move between the modules the bar is showing
#   tab, shift-tab       the same, forwards and back
#   space, enter         activate the focused module, exactly as clicking it does
#   r                    its other action -- what a right-click reaches
#   escape               leave keyboard mode
#
# Activating a module hands the keyboard back as it fires, so a module that
# opens a panel (the launcher, the calendar, the tray) takes the keys itself.
#
# ── the keys ────────────────────────────────────────────────────────────────
#
# These are the names BarState knows (`moduleShown` in Bar.qml), and the labels
# are what the launcher's menu entries call the same things, so a key and the
# entry that flips it cannot drift apart.

set -uo pipefail

SHELL_ID="hayami-shell"
IPC_TARGET="bar"

# Every switchable module, and what to call it on screen.
KEYS="tray bluetooth network vpn volume memory cpu battery notifications clock updates menu workspaces layout tiling"

label_for() {
	case "$1" in
	tray) echo "Tray" ;;
	bluetooth) echo "Bluetooth" ;;
	network) echo "Network" ;;
	vpn) echo "VPN" ;;
	volume) echo "Volume" ;;
	memory) echo "Memory" ;;
	cpu) echo "CPU" ;;
	battery) echo "Battery" ;;
	notifications) echo "Notifications" ;;
	clock) echo "Clock" ;;
	updates) echo "Updates" ;;
	menu) echo "Menu button" ;;
	workspaces) echo "Workspaces" ;;
	layout) echo "Layout indicator" ;;
	tiling) echo "Tiling direction" ;;
	*) echo "$1" ;;
	esac
}

label_for_cluster() {
	case "$1" in
	status) echo "Status cluster" ;;
	time) echo "Time and updates" ;;
	layout) echo "Layout and workspaces" ;;
	*) echo "$1" ;;
	esac
}

# The freedesktop icon the OSD shows beside the message. Both names are in the
# icon theme this session uses; hayami-osd drops one it cannot find rather than
# drawing a placeholder, so a missing icon costs the picture, not the message.
icon_for_state() {
	[ "$1" = "shown" ] && echo "view-visible" || echo "view-hidden"
}

is_key() {
	case " $KEYS " in
	*" $1 "*) return 0 ;;
	*) return 1 ;;
	esac
}

# ── talking to the shell ─────────────────────────────────────────────────────

# Delivers one call and prints whatever the shell answered. `qs ipc` exits
# non-zero and starts nothing when no instance of the shell is running, but a
# missing IPC target is reported as text with exit 0, so the output is checked
# as well.
ipc() {
	local out
	out=$(qs ipc -c "$SHELL_ID" call "$IPC_TARGET" "$@" 2>&1) || return 1
	case "$out" in
	*"Target not found"* | *"Could not find"* | *"No running instances"* | *"Too few arguments"*) return 1 ;;
	esac
	printf '%s' "$out"
	return 0
}

# The shell is the only thing that can move the bar, so when it is not answering
# there is nothing to fall back to.
no_shell() {
	echo "hayami-bar: hayami-shell is not running (try 'hayami-shell start')" >&2
	exit 1
}

# $1 message, $2 icon, $3 kind of change for the icon when $2 is empty.
tell() {
	local message="$1" icon="${2:-}"
	[ -n "$icon" ] || icon=$(icon_for_state "$3")
	hayami-osd --custom-message "$message" --custom-icon "$icon" >/dev/null 2>&1 || true
}

usage() {
	cat >&2 <<EOF
usage:
  hayami-bar position {top|bottom|left|right}
  hayami-bar {toggle|show|hide} KEY
  hayami-bar cluster {status|time|layout} {on|off}
  hayami-bar all
  hayami-bar keyboard [on|off|toggle]
  hayami-bar state

  keys: $KEYS
EOF
}

# ── verbs ────────────────────────────────────────────────────────────────────

do_position() {
	local edge="${1:-}"
	case "$edge" in
	top | bottom | left | right) ;;
	"")
		echo "hayami-bar: position needs an edge" >&2
		usage
		exit 2
		;;
	*)
		echo "hayami-bar: no such edge '$edge' (top, bottom, left, right)" >&2
		exit 2
		;;
	esac

	# Nothing to report either way: the bar moving *is* the feedback, and an OSD
	# over the screen saying "Bar: Left" would only be a second, smaller version
	# of what the user just watched happen -- and would sit on top of the windows
	# the move has just re-laid out. An edge the bar is already on is not an error
	# either, and is quiet for the same reason.
	ipc edge "$edge" >/dev/null || no_shell
}

do_switch() {
	local verb="${1:-}" key="${2:-}"
	[ -n "$key" ] || {
		echo "hayami-bar: $verb needs a key" >&2
		usage
		exit 2
	}
	is_key "$key" || {
		echo "hayami-bar: no such module '$key'" >&2
		usage
		exit 2
	}

	local call="toggle"
	[ "$verb" = "show" ] && call=reveal
	[ "$verb" = "hide" ] && call=conceal

	local got
	got=$(ipc "$call" "$key") || no_shell
	[ "$got" = "shown" ] || got="hidden"

	tell "$(label_for "$key"): $got" "" "$got"
}

do_cluster() {
	local name="${1:-}" on="${2:-}"
	case "$name" in
	status | time | layout) ;;
	"")
		echo "hayami-bar: cluster needs a name" >&2
		usage
		exit 2
		;;
	*)
		echo "hayami-bar: no such cluster '$name' (status, time, layout)" >&2
		exit 2
		;;
	esac

	local flag
	case "$on" in
	on | true | 1) flag=1 ;;
	off | false | 0) flag=0 ;;
	*)
		echo "hayami-bar: cluster needs on or off" >&2
		usage
		exit 2
		;;
	esac

	local got
	got=$(ipc cluster "$name" "$flag") || no_shell
	[ "$got" = "shown" ] || got="hidden"

	tell "$(label_for_cluster "$name"): $got" "" "$got"
}

do_all() {
	ipc revealAll >/dev/null || no_shell
	tell "All bar modules: shown" "view-visible"
}

do_keyboard() {
	local on="${1:-toggle}"
	case "$on" in
	on | off | toggle) ;;
	*)
		echo "hayami-bar: keyboard needs on, off or toggle" >&2
		usage
		exit 2
		;;
	esac

	# Quiet either way, and no OSD: the ring appearing or going is the bar
	# saying it has the keys or has handed them back, the same way the bar
	# moving is the bar saying it moved.
	ipc keyboard "$on" >/dev/null || no_shell
}

# ── entry ────────────────────────────────────────────────────────────────────

case "${1:-}" in
position) do_position "${2:-}" ;;
toggle | show | hide) do_switch "$1" "${2:-}" ;;
cluster) do_cluster "${2:-}" "${3:-}" ;;
all) do_all ;;
keyboard) do_keyboard "${2:-toggle}" ;;
state) ipc state || no_shell ;;
"" | -h | --help) usage ;;
*)
	echo "hayami-bar: unknown command '$1'" >&2
	usage
	exit 2
	;;
esac
