#!/usr/bin/env bash

SAVE_DIR="$HOME/Videos/Captures/"
mkdir -p "$SAVE_DIR"
FILENAME="$SAVE_DIR/recording_$(date +'%Y-%m-%d_%H-%M-%S').mp4"

AUDIO_SOURCE="$(pactl get-default-sink).monitor"
LOCK_FILE="/tmp/wf_recording_active"

# On-screen overlay helper (uses SwayOSD if available, falls back to transient notify-send)
show_osd() {
  local msg="$1"
  if command -v swayosd-client &>/dev/null; then
    swayosd-client --custom-message "$msg" --custom-icon "camera-video"
  else
    notify-send "Screen Recorder" "$msg" -i "camera-video" -t 2000 -a "screen-record"
  fi
}

# Fail loudly when the recorder isn't installed instead of reporting a false
# success. Without this the script announced "Recording Started", lit the
# Waybar indicator and then silently produced nothing, because the background
# `wf-recorder` call exited immediately with "command not found".
if ! command -v wf-recorder >/dev/null 2>&1; then
  show_osd "Screen recorder not installed - run: sudo pacman -S wf-recorder"
  exit 1
fi

# 1. Stop recording if currently active
if pgrep -x "wf-recorder" >/dev/null; then
  pkill -x --signal SIGINT "wf-recorder"

  # Clean up state lock and signal Waybar
  rm -f "$LOCK_FILE"
  pkill -RTMIN+8 waybar &>/dev/null

  show_osd "Recording Stopped & Saved"
  exit 0
fi

# 2. Select mode via Walker
CHOICE=$(printf "Screen\nWindow\nRegion" | walker --dmenu)

case "$CHOICE" in
"Screen")
  GEOM=""
  ;;
"Window")
  sleep 0.2
  GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
  if [ -z "$GEOM" ] || [ "$GEOM" = "null,null nullxnull" ]; then
    show_osd "No active window detected!"
    exit 1
  fi
  ;;
"Region")
  GEOM=$(slurp)
  if [ -z "$GEOM" ]; then
    exit 0
  fi
  ;;
*)
  exit 0
  ;;
esac

# Create state lock and trigger instant Waybar refresh
touch "$LOCK_FILE"
pkill -RTMIN+8 waybar &>/dev/null

# Background watcher to launch wf-recorder and ensure lockfile cleanup when finished
(
  if [ -n "$GEOM" ]; then
    wf-recorder --audio="$AUDIO_SOURCE" -g "$GEOM" -f "$FILENAME"
  else
    wf-recorder --audio="$AUDIO_SOURCE" -f "$FILENAME"
  fi

  # Cleanup lockfile on exit (whether stopped manually or killed)
  rm -f "$LOCK_FILE"
  pkill -RTMIN+8 waybar &>/dev/null
) &
RECORDER_JOB=$!

# Only claim success once the recorder has survived startup: a bad geometry or
# an unusable audio source kills it within milliseconds, and this used to be
# announced as "Recording Started" too. The subshell outlives wf-recorder only
# while it is actually capturing, so its liveness is the signal we want.
sleep 0.3
if kill -0 "$RECORDER_JOB" 2>/dev/null; then
  show_osd "Recording Started"
else
  show_osd "Recording failed - check that your display and audio are available"
  exit 1
fi
