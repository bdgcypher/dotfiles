# --- Global UI & Behavior ---
--ignore-errors
--no-warnings
--console-title
--no-mtime
--progress

# --- Global Metadata & Art ---
--add-metadata
--embed-thumbnail
--convert-thumbnails jpg

# --- Global Anti-Ban / Throttling Protection ---
--sleep-requests 1
--sleep-interval 5
--max-sleep-interval 30

# --- Global Caching & History ---
--cache-dir ~/.cache/yt-dlp
--download-archive ~/.config/yt-dlp/archive.txt
